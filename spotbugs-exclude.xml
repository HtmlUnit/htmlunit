<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Ignored bug categories -->
    <Bug pattern="SE_NO_SERIALVERSIONID"/>

    <Bug pattern="EI_EXPOSE_REP"/>
    <Bug pattern="EI_EXPOSE_REP2"/>

    <Bug pattern="CT_CONSTRUCTOR_THROW"/>

    <!--
        The DOM is not thread-safe by design; the scripts of a page are executed synchronized on the page.
        The fields are listed one by one, new fields of these classes are still reported.
    -->
    <Match>
        <Bug pattern="AT_STALE_THREAD_WRITE_OF_PRIMITIVE"/>
        <Or>
            <And>
                <Class name="org.htmlunit.html.DomNode"/>
                <Or>
                    <Field name="startLineNumber_"/>
                    <Field name="startColumnNumber_"/>
                    <Field name="endLineNumber_"/>
                    <Field name="endColumnNumber_"/>
                    <Field name="attachedToPage_"/>
                </Or>
            </And>
            <And>
                <Class name="org.htmlunit.html.DomElement"/>
                <Or>
                    <Field name="mouseOver_"/>
                    <Field name="writingCssomStyle_"/>
                </Or>
            </And>
            <And>
                <Class name="org.htmlunit.html.HtmlElement"/>
                <Or>
                    <Field name="shiftPressed_"/>
                    <Field name="ctrlPressed_"/>
                    <Field name="altPressed_"/>
                    <Field name="metaPressed_"/>
                </Or>
            </And>
            <And>
                <Class name="org.htmlunit.html.HtmlPage"/>
                <Or>
                    <Field name="autofocusAfterLoad_"/>
                    <Field name="autofocusProcessed_"/>
                </Or>
            </And>
            <And>
                <Class name="org.htmlunit.css.CssStyleSheet"/>
                <Field name="enabled_"/>
            </And>
            <And>
                <Class name="org.htmlunit.platform.canvas.rendering.AwtRenderingBackend"/>
                <Or>
                    <Field name="globalAlpha_"/>
                    <Field name="lineWidth_"/>
                </Or>
            </And>
        </Or>
    </Match>

    <!--
        The filter type org.w3c.dom.traversal.NodeFilter is part of the public api and can't be changed;
        the filters created by HtmlUnit (javascript) are serializable.
    -->
    <Match>
        <Bug pattern="SE_BAD_FIELD"/>
        <Or>
            <Class name="org.htmlunit.html.DomNodeIterator"/>
            <Class name="org.htmlunit.html.HtmlDomTreeWalker"/>
        </Or>
        <Field name="filter_"/>
    </Match>

    <!--
        SpotBugs treats XMLHttpRequest as shared between threads because doSend() synchronizes
        on the script lock of the page (SgmlPage.getScriptLock()).
        All the fields are written by the scripts of the page (open(), send(), abort(), the setters),
        which hold this lock (JavaScriptEngine), or by doSend() while holding it; the values set before
        send() are passed to the thread of the event loop by the job manager (synchronized).
    -->
    <Match>
        <Bug pattern="AT_STALE_THREAD_WRITE_OF_PRIMITIVE"/>
        <Class name="org.htmlunit.javascript.host.xml.XMLHttpRequest"/>
    </Match>

    <!--
        DomElement.ATTRIBUTE_NOT_DEFINED is a marker instance, the identity check is intended
        (an empty attribute value is equal to the marker but not the same).
    -->
    <Match>
        <Bug pattern="ES_COMPARING_PARAMETER_STRING_WITH_EQ"/>
        <Class name="org.htmlunit.html.DomElement"/>
        <Method name="isAttributeDefined"/>
    </Match>

    <!--
        ComputedCssStyleDeclaration.EMPTY_FINAL is a marker instance, the identity check is intended
        (an empty value is converted to '0px').
    -->
    <Match>
        <Bug pattern="ES_COMPARING_PARAMETER_STRING_WITH_EQ"/>
        <Class name="org.htmlunit.css.ComputedCssStyleDeclaration"/>
        <Method name="pixelString"/>
    </Match>

    <!--
        HttpClientCookie is only a carrier of the HttpClient cookie; the identity of a cookie is
        name, domain and path (Cookie.equals()), a HttpClientCookie has to be equal to a Cookie
        with the same identity.
    -->
    <Match>
        <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS"/>
        <Class name="org.htmlunit.httpclient.HttpClientCookie"/>
    </Match>

    <!--
        The identity check of the strings is an intended shortcut (performance);
        the result is the same without it.
    -->
    <Match>
        <Bug pattern="ES_COMPARING_PARAMETER_STRING_WITH_EQ"/>
        <Class name="org.htmlunit.util.StringUtils"/>
        <Or>
            <Method name="startsWithIgnoreCase"/>
            <Method name="endsWithIgnoreCase"/>
            <Method name="containsIgnoreCase"/>
        </Or>
    </Match>

    <!-- Exclude org.htmlunit.util.brotli package -->
    <Match>
        <Package name="org.htmlunit.util.brotli"/>
    </Match>
</FindBugsFilter>